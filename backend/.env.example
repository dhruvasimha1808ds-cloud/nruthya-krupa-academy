
# Copy this file to .env and set real values locally or in Render.

PORT=4000

# Replace with a long, random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret-before-deployment

# Initial admin credentials — change before production.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional: persistent SQLite database location.
# DB_PATH=/var/data/nk_academy.db

